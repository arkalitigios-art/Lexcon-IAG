# Ruta local, nunca se confirma la base resultante.
LEXCON_DATABASE_URL=./data/lexcon.sqlite
LEXCON_STORAGE_DIR=./storage
# Solo para ejecutar la semilla ficticia local. No usar credenciales reales.
LEXCON_DEMO_PASSWORD=
# Supabase: URL y clave publicable para Auth/RLS. No son la clave de servicio.
# NEXT_PUBLIC_SUPABASE_URL=https://<id-proyecto>.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Valor privado, exclusivo de las tareas administrativas del servidor y worker.
# LEXCON_SUPABASE_URL=https://<id-proyecto>.supabase.co
# LEXCON_SUPABASE_SERVICE_ROLE_KEY=
# Protege la ejecución explícita de la semilla ficticia remota.
# LEXCON_ALLOW_DEMO_SEED=false
